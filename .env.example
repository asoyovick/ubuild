# Example environment variables for UBuild.
# Copy to .env.local and fill in real values when integrating services.

# Base URL of the site (used for emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP / email service (e.g. Resend, SendGrid) for contact form delivery
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=

# Production database connection string (replaces the local JSON store)
# DATABASE_URL=
