# Example environment variables for UBuild.
# Copy to .env.local and fill in real values when integrating services.

# Base URL of the site (used for emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-facing Go API path (requests are proxied by Next.js).
NEXT_PUBLIC_API_BASE_URL=/api/backend
# Server-side URL used by Next.js to fetch dashboard data from Go.
UBUILD_API_URL=http://localhost:8080

# SMTP / email service (e.g. Resend, SendGrid) for contact form delivery
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=

# Production database connection string (replaces the local JSON store)
# DATABASE_URL=
